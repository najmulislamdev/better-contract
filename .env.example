# Copy to .env and fill in real values: `cp .env.example .env`

# PostgreSQL connection string used by Prisma (see prisma/ — schema lands in a later task).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/better_contract?schema=public"

# Absolute base URL of the site. Used for canonical URLs, sitemaps and absolute
# links in metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
